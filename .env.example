# Public URL used to render the install QR code. Do not put secrets here.
VITE_PUBLIC_APP_URL=https://example.com

# Browser builds can only read VITE_* variables. Use placeholder values only.
VITE_OPENAI_API_KEY=replace-with-development-key-only
VITE_GEMINI_API_KEY=replace-with-development-key-only

# Optional defaults are editable in the Settings UI.
VITE_OPENAI_ENDPOINT=https://api.openai.com/v1
VITE_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
VITE_LOCAL_OPENAI_ENDPOINT=http://localhost:11434/v1
