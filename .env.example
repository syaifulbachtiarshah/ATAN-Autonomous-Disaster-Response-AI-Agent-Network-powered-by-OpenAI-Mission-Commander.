# Public URL used to render the install QR code. Do not put secrets here.
VITE_PUBLIC_APP_URL=https://example.com

# Public browser configuration only. Provider credentials belong in the server-side proxy
# environment and must never use a VITE_* name or be passed to this build.
VITE_OPENAI_PROXY_URL=/api/providers/openai
VITE_GEMINI_PROXY_URL=/api/providers/gemini
VITE_LOCAL_OPENAI_ENDPOINT=http://localhost:11434/v1
